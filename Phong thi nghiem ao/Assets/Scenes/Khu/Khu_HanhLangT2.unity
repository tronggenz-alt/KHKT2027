  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Khkt.Demo.LabScreen
  screenId: t2_hanh_lang
  slideFolder: t2_hanh_lang
  surface: {fileID: 1833797465}
  titleText: {fileID: 1661400733}
  bodyText: {fileID: 1022924135}
  background: {fileID: 2800000, guid: bf7cebd4d8a0c1b4ebb5749c4b96cd77, type: 3}
  liveCamera: {fileID: 0}
  liveResolution: {x: 640, y: 360}
  liveFps: 8
  autoAdvanceS: 10
  pages:
  - title: "PH\xD2NG LAB SINH H\u1ECCC 3D (WEB)"
    body: "Gi\u1EA3i ph\u1EABu ng\u01B0\u1EDDi th\u1EADt BodyParts3D \xB7 15 c\u01A1 quan\nTim \xB7 M\u1EA1ch m\xE1u \xB7 Ph\u1ED5i \xB7 N\xE3o \xB7 T\u1EE7y s\u1ED1ng \xB7 Th\u1EADn \xB7 D\u1EA1 d\xE0y\nRu\u1ED9t non \xB7 Ru\u1ED9t gi\xE0 \xB7 Gan \xB7 T\u1EE5y \xB7 L\xE1ch \xB7 X\u01B0\u01A1ng \xB7 C\u01A1 \xB7 Da"
    image: {fileID: 0}
    live: 0
  - title: "6 C\u1EA2NH HI\u1EC2N VI"
    body: "Ph\u1EBF nang \xB7 Nephron \xB7 Synapse \xB7 Sarcomere\nT\u1EBF b\xE0o vi\u1EC1n d\u1EA1 d\xE0y \xB7 Ti\u1EC3u th\xF9y gan\nTi\xEAu b\u1EA3n \u1EDF h\u1ED9p ti\xEAu b\u1EA3n tr\xEAn m\u1ED7i b\xE0n"
    image: {fileID: 0}
    live: 0
  - title: "L\u1ECACH PH\xD2NG SINH H\u1ECCC"
    body: "S\xE1ng: Sinh 10 \u2013 t\u1EBF b\xE0o, enzyme\nChi\u1EC1u: Sinh 11 \u2013 quang h\u1EE3p, h\xF4 h\u1EA5p\nC\xE2u l\u1EA1c b\u1ED9 KHKT: th\u1EE9 B\u1EA3y"
    image: {fileID: 0}
    live: 0
