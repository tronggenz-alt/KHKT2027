  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Khkt.Demo.LabScreen
  screenId: t2_tuong_video_1
  slideFolder: t2_tuong_video_1
  surface: {fileID: 31072035}
  titleText: {fileID: 1399020186}
