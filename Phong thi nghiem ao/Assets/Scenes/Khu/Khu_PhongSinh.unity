  background: {fileID: 2800000, guid: bf7cebd4d8a0c1b4ebb5749c4b96cd77, type: 3}
  liveCamera: {fileID: 0}
  liveResolution: {x: 640, y: 360}
  liveFps: 8
  autoAdvanceS: 14
  pages:
  - title: "PH\xD2NG TH\xCD NGHI\u1EC6M SINH H\u1ECCC"
    body: "Quan s\xE1t t\u1EBF b\xE0o \xB7 Enzyme \xB7 L\xEAn men \xB7 Quang h\u1EE3p\nT\xE1ch chi\u1EBFt ADN \xB7 Nu\xF4i c\u1EA5y vi sinh \xB7 Gi\u1EA3i ph\u1EABu s\u1ED1"
    image: {fileID: 0}
    live: 0
  - title: "B\xC0I H\u1ECCC H\xD4M NAY: CO V\xC0 PH\u1EA2N CO NGUY\xCAN SINH"
    body: "1. T\xE1ch bi\u1EC3u b\xEC v\u1EA3y h\xE0nh t\xEDm, \u0111\u1EB7t l\xEAn lam k\xEDnh\n2. Nh\u1ECF n\u01B0\u1EDBc c\u1EA5t, \u0111\u1EADy lamen, soi \u1EDF v\u1EADt k\xEDnh 10\xD7\n3. Nh\u1ECF NaCl 5 % \u1EDF m\u1ED9t c\u1EA1nh lamen, gi\u1EA5y th\u1EA5m \u1EDF c\u1EA1nh kia\n4. M\xE0ng sinh ch\u1EA5t t\xE1ch kh\u1ECFi th\xE0nh t\u1EBF b\xE0o: co nguy\xEAn sinh\n5. Thay b\u1EB1ng n\u01B0\u1EDBc c\u1EA5t: t\u1EBF b\xE0o ph\u1EA3n co nguy\xEAn sinh"
    image: {fileID: 0}
    live: 0
