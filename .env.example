# Dán API key của Anthropic vào sau dấu "=" (lấy tại https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Mô hình Claude – CHỈ dùng cho bài HSG của admin / tài khoản có mã Claude (mặc định không ai dùng Claude)
CLAUDE_MODEL=claude-sonnet-5-5

# Mức suy nghĩ khi tra cứu và giải: low | medium | high
CLAUDE_EFFORT=medium

# 1 = bật cơ chế tự chuyển mô hình dự phòng phía máy chủ khi bị từ chối; 0 = tắt
CLAUDE_FALLBACK=1

# ----- Gemini: AI chính, chọn mô hình theo độ khó đề (do Gemini Flash-Lite phân loại trước khi giải)
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Đề Dễ (+ phân loại độ khó, đọc đề chữ)        Đề Trung bình (+ tra cứu, đọc ảnh đề)     Đề HSG (Claude lỗi cũng về đây)
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest
# (tên cũ vẫn nhận: GEMINI_MODEL = bậc Flash, GEMINI_MODEL_HSG = bậc Pro)
# 1 = bật tự chuyển Claude → Gemini Pro khi Claude lỗi; 0 = tắt
GEMINI_FALLBACK=1

# ----- Đăng nhập + key Gemini riêng của từng người dùng (BYOK) – xem README mục 3
# Đăng nhập email + mật khẩu luôn có sẵn. GOOGLE_CLIENT_ID/SECRET (tuỳ chọn) để thêm nút "Tiếp tục với Google".
# OAuth client (Web application) tạo tại https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: http://127.0.0.1:8000/auth/callback (thêm cổng 8001 nếu cần)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khoá chính (≥ 32 ký tự) để mã hoá key Gemini của người dùng và ký cookie đăng nhập.
# ĐỂ TRỐNG LÀ ĐƯỢC: app tự tạo data/app_secret.key ở lần chạy đầu. Đổi khoá thì mọi key đã lưu phải nhập lại.
APP_SECRET_KEY=
# Số bài dùng thử bằng key của chủ app (ở trên) cho mỗi người chưa nhập key riêng
FREE_TRIAL_LIMIT=3
# Email chủ app (cách nhau dấu phẩy): dùng key của chủ app không giới hạn
ADMIN_EMAILS=
# 1 = cookie đăng nhập chỉ gửi qua HTTPS (Chrome/Firefox vẫn nhận trên http://127.0.0.1); Safari + http thì đặt 0
COOKIE_SECURE=1
# Chỉ cần khi chạy sau reverse proxy HTTPS, vd https://ten-mien-cua-ban/auth/callback
OAUTH_REDIRECT_URI=

# ----- Xác thực email khi tạo tài khoản / quên mật khẩu (BẮT BUỘC để có tài khoản mới) – nháy đúp cau-hinh-email.command
# Gmail + App Password (16 ký tự, tạo tại https://myaccount.google.com/apppasswords – cần bật Xác minh 2 bước)
SMTP_USER=
SMTP_PASS=
# Mặc định smtp.gmail.com:587 (STARTTLS); đổi khi dùng máy chủ khác (465 = SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Người gửi hiển thị (mặc định = SMTP_USER)
EMAIL_FROM=
# Có thì gửi qua Resend (https://resend.com) thay cho SMTP; EMAIL_FROM phải thuộc tên miền đã xác minh trên Resend
RESEND_API_KEY=
# Cloudflare Turnstile (captcha miễn phí) ở form Tạo tài khoản – dash.cloudflare.com → Turnstile; để trống = tắt
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- IP thật của người dùng trong nhật ký đăng nhập (backend/dia_chi_ip.py)
# Proxy được tin header IP (CF-Connecting-IP / X-Forwarded-For / X-Real-IP), cách nhau dấu phẩy: IP, dải CIDR, hoặc "cloudflare"
# (= dải IP Cloudflare). Mặc định: 127.0.0.1,::1,cloudflare (đủ cho Cloudflare Tunnel). Lên Render: thêm dải nội bộ, vd 10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1,cloudflare
# File .mmdb tra vị trí + nhà mạng OFFLINE (nháy đúp tai-du-lieu-ip.command để tải GeoLite2 hoặc DB-IP Lite vào data/geoip/).
# Để trống = tự tìm trong data/geoip/; thiếu file thì bỏ qua phần vị trí, không báo lỗi.
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# ----- Key Claude dùng chung (backend/key_claude.py) – nháy đúp cau-hinh-key-claude.command để đặt / đổi (gõ ẩn, không hiện key)
# Người dùng (không phải admin) nhập đúng key trong Cài đặt → Key Claude thì được giải bằng Claude của máy chủ (ANTHROPIC_API_KEY).
# Để trống = tắt (chỉ admin + người có mã Claude dùng được Claude). Đổi key + khởi động lại → mọi tài khoản kích hoạt bằng key cũ mất quyền.
CLAUDE_ACCESS_KEY=
# Số bài Claude tối đa mỗi người mỗi ngày khi mở bằng key (mặc định 10; admin không giới hạn)
CLAUDE_DAILY_LIMIT=10

# ----- Admin API của Anthropic (backend/claude_admin.py) – /admin → "Claude API (máy chủ)": chi phí + token Claude, số dư ước tính.
# Admin key dạng sk-ant-admin01-… (platform.claude.com → Settings → Admin keys; chỉ tài khoản Tổ chức). KHÁC ANTHROPIC_API_KEY.
# Nháy đúp cau-hinh-claude.command (dán key nào cũng được, tự nhận ra loại) để đặt (gõ ẩn). Để trống = chỉ hiện nhật ký chi phí nội bộ của app.
ANTHROPIC_ADMIN_KEY=

# ----- API key Claude RIÊNG của người dùng (Cài đặt → 07): mã hoá Fernet bằng khoá suy từ USER_KEY_SECRET (chuỗi ngẫu nhiên ≥ 32 ký tự).
# Để trống = dùng khoá chính của app (vẫn mã hoá). Đặt sau vẫn đọc được key đã lưu trước đó; XOÁ đi thì người dùng phải nhập lại key.
USER_KEY_SECRET=

# ----- Tra cứu tài liệu khoa học (backend/literature.py – chỉ API hợp pháp, miễn phí: Crossref, Unpaywall, OpenAlex, Semantic Scholar,
# Europe PMC, arXiv, PubChem). Email liên hệ gửi kèm User-Agent / bắt buộc với Unpaywall (trống = dùng SMTP_USER).
UNPAYWALL_EMAIL=
# Key Semantic Scholar (tuỳ chọn – không có thì hay bị giới hạn 429, app tự thử lại rồi bỏ qua)
S2_API_KEY=
# 1 = công tắc "Tự động" bật tra cứu ở mức Kỹ / Tối đa; 0 = chỉ khi người dùng bật hoặc đề có DOI
TRA_CUU_TU_DONG=1

# ----- ChatGPT (OpenAI) – AI thứ 3 (backend/ai/providers/openai) – nháy đúp cau-hinh-openai.command để đặt (gõ ẩn, gọi thử, ghi .env)
# Thiếu key HOẶC model → app tự bỏ qua ChatGPT. Key chỉ dùng ở server. Thứ tự dự phòng: backend/ai/routing.json + /admin → Thứ tự AI.
OPENAI_API_KEY=
# Tên mô hình (không viết cứng trong code). Gợi ý 10/2026: gpt-6.1-sol (cân bằng, đọc được ảnh) · gpt-6-astra (mạnh nhất) · gpt-6-luna (rẻ)
OPENAI_MODEL=
# Tuỳ chọn: nhiệt độ (trống = mặc định của mô hình), trần token đầu ra (trống = theo từng yêu cầu)
OPENAI_TEMPERATURE=
OPENAI_MAX_TOKENS=
# ----- Thời gian chờ AI: Claude / ChatGPT quá N giây không nhận được dữ liệu → chuyển AI kế tiếp; Gemini: tổng thời gian tối đa mỗi lần gọi
AI_TIMEOUT_GIAY=30
AI_TIMEOUT_DAI_GIAY=300

# ----- Chạy trên máy chủ (Render / Docker – xem Dockerfile, render.yaml, HUONG_DAN_DUA_LEN_WEB.md). Trên Mac để trống / 1.
# STORAGE_DIR: thư mục ổ đĩa lưu dữ liệu (data/, outputs/, logs/) – Render: /var/data. Trống = trong thư mục dự án.
STORAGE_DIR=
# CHE_DO_CUC_BO: 1 = máy chạy app (Mac) vào thẳng quyền chủ app khi chưa bật đăng nhập Google; BẮT BUỘC 0 trên máy chủ
CHE_DO_CUC_BO=1
# ----- Máy chủ KHÔNG có ổ đĩa lưu (Render Free): sao lưu data/app.db + data/ai_rieng vào repo GitHub riêng tư (backend/sao_luu.py)
# SAO_LUU_GITHUB_REPO=tài-khoản/tên-repo · SAO_LUU_GITHUB_TOKEN=token fine-grained chỉ repo đó (Contents: Read and write) · SAO_LUU_PHUT=2
SAO_LUU_GITHUB_REPO=
SAO_LUU_GITHUB_TOKEN=
SAO_LUU_PHUT=
# CAP_ADMIN_EMAIL: máy chủ không có Shell → tài khoản email + mật khẩu đã xác thực email trùng địa chỉ này tự thành admin
CAP_ADMIN_EMAIL=
# BREVO_API_KEY: gửi mã xác thực qua API web của Brevo (miễn phí 300 thư/ngày) – BẮT BUỘC khi máy chủ chặn SMTP (Render Free).
# EMAIL_FROM phải là địa chỉ đã xác minh trong Brevo → Senders. Có RESEND_API_KEY thì Resend được ưu tiên.
BREVO_API_KEY=
# NOTEBOOKLM_COOKIE_KEY: khoá AES-256-GCM mã hoá cookie Google NotebookLM trước khi lưu CSDL (≥ 32 ký tự ngẫu nhiên).
# Mac: chạy cau-hinh-notebooklm.command. Render: render.yaml tự sinh. Đổi khoá = phải dán lại cookie các tài khoản.
NOTEBOOKLM_COOKIE_KEY=
